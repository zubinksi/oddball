    "start": "tsx dev-server.ts"
  },
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
